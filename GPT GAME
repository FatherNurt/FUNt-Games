    function showK3Response(choice) {
      const responses = {
        A: "🤖 What colors do you see in a rainbow? Say or type them!",
        B: "🤖 Name something you've seen for each: Fire, Water, Earth, Wind.",
        C: "🤖 What animals, plants, or fungi have you seen near you?",
        D: "🤖 Ask anything! Try: What are stars? Can trees talk? Where does the sky end?"
      };
      document.getElementById('K3Response').innerText = responses[choice];
    }
  </script>

