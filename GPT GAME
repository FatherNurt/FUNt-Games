<body>

  <h1>🌌 FUNt Cosmos Simulation v1.0</h1>
  <div class="section">
    <p>Welcome to the FUNt Cosmos Simulation! Please select your education level:</p>
    <button onclick="showLevel('K3')">1. K–3 (Kindergarten to Grade 3)</button>
  </div>

  <div id="K3" class="section" style="display:none;">
    <h2>Welcome, Little Explorer!</h2>
    <p>Choose a topic:</p>
    <button onclick="showK3Response('A')">A) 🎨 Colors of the Rainbow</button><br>
    <button onclick="showK3Response('B')">B) 🌍 Earth, Fire, Wind, Water</button><br>
    <button onclick="showK3Response('C')">C) 🐾 Earth’s Subspecies</button><br>
    <button onclick="showK3Response('D')">D) ❓ Ask Me Anything</button>

